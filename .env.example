# Environment Configuration
# Copy this file to .env and fill in your Trello API credentials

# Trello API Configuration
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here
TRELLO_BOARD_ID=your_board_id_here

# Server Configuration
PORT=3000
WEBHOOK_SECRET=your_webhook_secret_here

# Lists Configuration (comma-separated list IDs)
# You can find list IDs from your Trello board
WORK_LIST_IDS=list_id_1,list_id_2
UNIVERSITY_LIST_IDS=list_id_3,list_id_4

# Wallpaper Configuration
WALLPAPER_WIDTH=1179
WALLPAPER_HEIGHT=2556
BACKGROUND_COLOR=#1a1a1a
TEXT_COLOR=#ffffff
FONT_SIZE=24